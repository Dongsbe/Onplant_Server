# Copy this file to .env and replace the credentials. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=onplant
DB_PASSWORD=CHANGE_ME
DB_NAME=onplant
ONPLANT_DATA=onplant_state.json
ONPLANT_CAMERA_KEY=change-this-camera-key
ONPLANT_ROBOT_API_KEY=change-this-robot-api-key
ONPLANT_STT_MODEL=small
ONPLANT_STT_DEVICE=cpu
ONPLANT_STT_COMPUTE_TYPE=int8
ONPLANT_STT_PROMPT=동스비. 오늘 상태 어때. 최적 조도 찾아줘. 멈춰. 오늘 진주 날씨 어때. 오늘 진주 날씨 알려줘.
